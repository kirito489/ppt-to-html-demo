generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model SystemLogRecord {
  id           String   @id @default(uuid())
  memberId     String?  @map("member_id")
  action       String
  ipAddress    String?  @map("ip_address")
  method       String?
  url          String?
  request      String?  @db.Text
  response     String?  @db.Text
  statusCode   Int?     @map("status_code")
  execTime     Float?   @map("exec_time")
  requestTime  DateTime @map("request_time")
  responseTime DateTime @map("response_time")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("system_logs")
}

// ORM Record — 只存在於 adapter/out/persistence 層，與 Domain Member 完全分離
model MemberRecord {
  id                 String    @id @default(uuid())
  member             String    @db.VarChar(100)
  password           String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  status             Boolean   @default(true)
  isDefault          Boolean   @default(false) @map("is_default")
  lastPasswordChange DateTime? @map("last_password_change")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  @@map("members")
}

model AuthLogRecord {
  id        String   @id @default(uuid())
  memberId  String?  @map("member_id")
  email     String
  action    String   // LOGIN_SUCCESS | LOGIN_FAILURE | LOGOUT | REFRESH
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("auth_logs")
}

// 轉換後文章（PPT → HTML）
model ConvertedArticleRecord {
  id               String   @id @default(uuid())
  title            String   @db.VarChar(255)
  sourceFilename   String   @map("source_filename") @db.VarChar(255)
  html             String   @db.LongText
  // 對照面板用的來源元素中介結構（每頁文字/圖片/表格/未還原標記）
  inventory        Json
  slideCount       Int      @map("slide_count")
  accuracyOverall  Float    @map("accuracy_overall")
  accuracyText     Float    @map("accuracy_text")
  accuracyImage    Float    @map("accuracy_image")
  accuracyCoverage Float    @map("accuracy_coverage")
  status           String   @db.VarChar(20) // success | partial | failed
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("converted_articles")
}

// 攝取批次紀錄
model ConversionJobRecord {
  id             String    @id @default(uuid())
  trigger        String    @db.VarChar(20) // scheduled | manual
  startedAt      DateTime  @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  filesScanned   Int       @default(0) @map("files_scanned")
  filesConverted Int       @default(0) @map("files_converted")
  filesFailed    Int       @default(0) @map("files_failed")
  detail         Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("conversion_jobs")
}

model SeedHistoryRecord {
  id         Int      @id @default(autoincrement())
  seedName   String   @unique @map("seed_name") @db.VarChar(255)
  executedAt DateTime @default(now()) @map("executed_at")

  @@index([seedName], map: "idx_seed_name")
  @@map("seed_history")
}
