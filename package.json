{
  "name": "ppt-shift-html-demo",
  "version": "0.0.1",
  "description": "PPT 轉 HTML Demo — 定時抓取公槽 PPT、轉成不跑版 HTML 並提供準確率（NestJS + React monorepo）",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @app/api dev\" \"pnpm --filter @app/web dev\"",
    "build": "pnpm --filter @app/api build && pnpm --filter @app/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4"
  },
  "lint-staged": {
    "apps/api/**/*.ts": "pnpm --filter @app/api exec eslint --fix",
    "apps/web/**/*.{ts,tsx}": "pnpm --filter @app/web exec eslint --fix"
  }
}
